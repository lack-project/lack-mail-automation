{
  "name": "lack/mail-automation",
  "type": "library",
  "description": "Stateful mailbox automation, contact resolution and rule processing on top of phore/mail-client.",
  "license": "MIT",
  "repositories": [
    {"type": "vcs", "url": "https://github.com/phore/phore-mailclient"}
  ],
  "require": {
    "php": ">=8.5",
    "ext-json": "*",
    "ext-pdo": "*",
    "ext-pdo_sqlite": "*",
    "phore/log": "dev-master",
    "phore/mail-client": "dev-main"
  },
  "require-dev": {
    "phpunit/phpunit": "^13.2"
  },
  "autoload": {
    "classmap": ["src/"]
  },
  "autoload-dev": {
    "psr-4": {
      "Lack\\MailAutomation\\Test\\": "test/"
    }
  },
  "scripts": {
    "test": "phpunit test"
  },
  "minimum-stability": "dev",
  "prefer-stable": true
}
